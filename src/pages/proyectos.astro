---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';

const projects = [
    { id: 'PRJ-001', name: 'Rastreo en tiempo real', leader: 'Ana Silva', phase: 'Obtain/Build', status: 'En tiempo', priority: 'Alta', date: '25 Oct 2026' },
    { id: 'PRJ-002', name: 'App FastTrack V2.0', leader: 'Carlos Ruiz', phase: 'Design & Transition', status: 'Retrasado', priority: 'Alta', date: '10 Nov 2026' },
    { id: 'PRJ-003', name: 'Integración Pasarela Pagos', leader: 'Luis Gómez', phase: 'Deliver & Support', status: 'En riesgo', priority: 'Media', date: '02 Nov 2026' },
    { id: 'PRJ-004', name: 'Portal de Soporte B2B', leader: 'Marta Díaz', phase: 'Plan', status: 'En tiempo', priority: 'Baja', date: '15 Dic 2026' },
    { id: 'PRJ-005', name: 'Chatbot Atención al Cliente', leader: 'Ana Silva', phase: 'Engage', status: 'En tiempo', priority: 'Media', date: '20 Ene 2027' },
    { id: 'PRJ-006', name: 'Migración Base de Datos', leader: 'Carlos Ruiz', phase: 'Deliver & Support', status: 'En tiempo', priority: 'Alta', date: '30 Oct 2026' }
];

const getStatusClass = (status) => {
    if (status === 'En tiempo') return 'status-good';
    if (status === 'En riesgo') return 'status-warning';
    if (status === 'Retrasado') return 'status-danger';
    return '';
};
---

<Layout title="Proyectos - Service Value Chain Dashboard">
    <div class="dashboard-layout">
        <Sidebar />
        
        <div class="main-content">
            <Header />
            
            <main class="dashboard-content">
                <div class="dashboard-header">
                    <h1>Proyectos y Servicios</h1>
                    <p>Listado completo de iniciativas en la Cadena de Valor</p>
                </div>

                <div class="projects-container">
                    <div class="table-responsive">
                        <table class="projects-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre del Proyecto</th>
                                    <th>Líder (Dueño)</th>
                                    <th>Eslabón ITIL</th>
                                    <th>Prioridad</th>
                                    <th>Estado</th>
                                    <th>Fecha Estimada</th>
                                </tr>
                            </thead>
                            <tbody>
                                {projects.map(p => (
                                    <tr>
                                        <td class="col-id" data-label="ID">{p.id}</td>
                                        <td class="col-name" data-label="Nombre del Proyecto"><strong>{p.name}</strong></td>
                                        <td data-label="Líder (Dueño)">
                                            <div class="leader-cell">
                                                <div class="avatar-sm">{p.leader.split(' ').map(n => n[0]).join('')}</div>
                                                <span>{p.leader}</span>
                                            </div>
                                        </td>
                                        <td data-label="Eslabón ITIL"><span class="phase-badge">{p.phase}</span></td>
                                        <td data-label="Prioridad"><span class={`priority-badge p-${p.priority.toLowerCase()}`}>{p.priority}</span></td>
                                        <td data-label="Estado"><span class={`status-dot ${getStatusClass(p.status)}`}>{p.status}</span></td>
                                        <td class="col-date" data-label="Fecha Estimada">{p.date}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
</Layout>

<style>
    .dashboard-content {
        padding: 30px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .dashboard-header {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .dashboard-header h1 {
        font-size: 1.8rem;
        color: var(--primary-color);
    }

    .dashboard-header p {
        margin: 0;
        color: #666;
        font-size: 0.95rem;
    }

    .projects-container {
        background-color: var(--card-bg);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid rgba(0,0,0,0.05);
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .table-responsive {
        overflow-x: auto;
        border-radius: 8px;
        border: 1px solid #eee;
    }

    .projects-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
        text-align: left;
    }

    .projects-table th {
        background-color: #f9f9f9;
        padding: 14px 20px;
        font-size: 0.85rem;
        color: #666;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #eee;
    }

    .projects-table td {
        padding: 16px 20px;
        border-bottom: 1px solid #eee;
        vertical-align: middle;
        font-size: 0.95rem;
    }

    .projects-table tr:hover {
        background-color: #fafafa;
    }

    .col-id {
        color: #888;
        font-size: 0.85rem;
    }

    .col-name strong {
        color: var(--primary-color);
        font-weight: 500;
    }

    .leader-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar-sm {
        width: 28px;
        height: 28px;
        background-color: var(--accent-color);
        color: var(--primary-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .phase-badge {
        background-color: rgba(146, 183, 117, 0.15);
        color: var(--primary-color);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        display: inline-block;
    }

    .priority-badge {
        font-size: 0.85rem;
        font-weight: 500;
    }
    .p-alta { color: #d32f2f; }
    .p-media { color: #f57c00; }
    .p-baja { color: #388e3c; }

    .status-dot {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
    }

    .status-dot::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

    .status-good::before { background-color: #4caf50; }
    .status-warning::before { background-color: #ff9800; }
    .status-danger::before { background-color: #f44336; }

    .col-date {
        color: #555;
        font-size: 0.85rem;
    }

    @media (max-width: 1500px) {
        .table-responsive {
            border: none;
            overflow-x: hidden;
            background: transparent;
        }

        .projects-table, .projects-table tbody, .projects-table tr, .projects-table td {
            display: block;
            width: 100%;
        }

        .projects-table {
            min-width: 0;
        }

        .projects-table thead {
            display: none;
        }

        .projects-table tr {
            margin-bottom: 20px;
            border: 1px solid #eee;
            border-radius: 12px;
            padding: 15px;
            background-color: #fff;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            transition: all 0.3s ease;
        }

        .projects-table tr:hover {
            border-color: var(--accent-color);
            transform: translateY(-2px);
        }

        .projects-table td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f9f9f9;
            text-align: right;
        }

        .projects-table td:last-child {
            border-bottom: none;
        }

        .projects-table td::before {
            content: attr(data-label);
            font-weight: 600;
            color: #666;
            text-align: left;
            margin-right: 15px;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .leader-cell {
            justify-content: flex-end;
        }
    }
    
    @media (max-width: 768px) {
        .dashboard-content {
            padding: 20px;
            padding-bottom: 40px;
        }
    }
</style>
