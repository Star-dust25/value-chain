---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';
---

<Layout title="Documentación - Service Value Chain Dashboard">
    <div class="dashboard-layout">
        <Sidebar />
        
        <div class="main-content">
            <Header />
            
            <main class="dashboard-content">
                <div class="dashboard-header">
                    <h1>Documentación del Proyecto</h1>
                    <p>Detalles exhaustivos y artefactos de valor</p>
                </div>

                <div class="doc-container">
                    <a href="/" class="back-link">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        Volver al Dashboard
                    </a>
                    
                    <div class="doc-content mockup-content">
                        <h2>Plan de Implementación y Diseño</h2>
                        <p>Esta página simula un repositorio de documentos asociados al proyecto. Aquí se incluirían enlaces a Confluence, Jira, repositorios de código y artefactos de arquitectura.</p>
                        
                        <div class="skeleton-text">
                            <div class="sk-line full"></div>
                            <div class="sk-line full"></div>
                            <div class="sk-line mid"></div>
                        </div>
                        
                        <br>
                        <h3>Métricas de Éxito Definidas</h3>
                        <div class="skeleton-text">
                            <div class="sk-line full"></div>
                            <div class="sk-line short"></div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</Layout>

<style>
    .dashboard-content {
        padding: 30px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .dashboard-header {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .dashboard-header h1 {
        font-size: 1.8rem;
    }

    .dashboard-header p {
        margin: 0;
        color: #666;
        font-size: 0.95rem;
    }

    .doc-container {
        background-color: var(--card-bg);
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.02);
        flex: 1;
        max-width: 900px;
    }
    
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 30px;
        padding: 8px 16px;
        background-color: rgba(146, 183, 117, 0.1);
        border-radius: 6px;
    }
    
    .back-link:hover {
        background-color: rgba(146, 183, 117, 0.2);
    }

    .mockup-content {
        color: #444;
        line-height: 1.8;
    }
    
    .mockup-content h2 {
        margin-bottom: 15px;
    }
    
    .mockup-content h3 {
        margin-bottom: 10px;
        margin-top: 20px;
    }

    .skeleton-text {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .sk-line {
        height: 16px;
        background-color: #f0f0f0;
        border-radius: 4px;
    }
    
    .sk-line.full { width: 100%; }
    .sk-line.mid { width: 70%; }
    .sk-line.short { width: 40%; }
</style>
